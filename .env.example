# All settings are optional with local Ollama and Docker Desktop.
EVIDENCE_RAG_MODEL=bge-m3
EVIDENCE_RAG_CHAT_MODEL=qwen3:4b
EVIDENCE_RAG_CHAT_CONTEXT=8192
EVIDENCE_RAG_HTTP_PORT=18080
EVIDENCE_RAG_ES_PORT=19200

# Set both for an external OpenAI-compatible embedding service over HTTPS.
# EVIDENCE_RAG_BASE_URL=https://your-provider.example/v1
# EVIDENCE_RAG_API_KEY=

# Optional separate model for selecting evidence and optional service-wide bearer token.
EVIDENCE_RAG_EXTRACTIVE_MODEL=
EVIDENCE_RAG_HTTP_TOKEN=
EVIDENCE_RAG_MAX_INFLIGHT=8
EVIDENCE_RAG_QUERY_CACHE_ENTRIES=0
