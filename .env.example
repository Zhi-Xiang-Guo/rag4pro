# OpenAI-compatible gateway. Replace the example URLs and model IDs.
EVIDENCE_RAG_BASE_URL=https://your-provider.example/v1
EVIDENCE_RAG_MODEL=embedding-model
EVIDENCE_RAG_API_KEY=
EVIDENCE_RAG_CHAT_PROVIDER=openai
EVIDENCE_RAG_CHAT_URL=https://your-provider.example/v1
EVIDENCE_RAG_CHAT_MODEL=chat-model
EVIDENCE_RAG_CHAT_API_KEY=
EVIDENCE_RAG_CHAT_CONTEXT=8192
EVIDENCE_RAG_HTTP_PORT=18080
EVIDENCE_RAG_ES_PORT=19200

# Choose fresh Compose volumes when switching embedding providers or models.
# EVIDENCE_RAG_PROJECT=evidence-rag-java-remote
# EVIDENCE_RAG_EVAL_PROJECT=evidence-rag-eval-remote

# Optional separate model for selecting evidence and optional service-wide bearer token.
EVIDENCE_RAG_EXTRACTIVE_MODEL=
EVIDENCE_RAG_HTTP_TOKEN=
EVIDENCE_RAG_MAX_INFLIGHT=8
EVIDENCE_RAG_QUERY_CACHE_ENTRIES=0
